PORT=5000

# Comma-separated browser origins allowed by CORS (CRA local default shown)
CORS_ORIGIN=http://localhost:3000

# Set to true during local/pilot testing to skip real SMS sends
SMS_DISABLED=false

# --- Local testing (recommended) ---
# CORS_ORIGIN=http://localhost:3000
# SMS_DISABLED=true
#
# --- Railway pilot (set in Railway dashboard, not in repo) ---
# PORT is assigned automatically by Railway
# SMS_DISABLED=true for initial pilot testing, then false for live SMS
# CORS_ORIGIN=https://your-frontend-domain.example
#
# Railway PostgreSQL — map plugin variables to the names this app expects:
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Kenya_ID_System
DB_USER=postgres
DB_PASSWORD=your_database_password_here

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES=7d

AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key_here

# Optional: used only by local setup/reset scripts (not required for the server)
TEST_OFFICER_PASSWORD=your_test_officer_password_here
